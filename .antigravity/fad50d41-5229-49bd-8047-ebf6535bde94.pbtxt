          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Console Layout based on Selected Mode"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        if (dualDeckState.deckMode == DeckMode.SINGLE_DECK) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // SINGLE DECK (SOLO AUDIOPHILE PLAYER)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val activeDeckId = dualDeckState.selectedSingleDeck"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val activeDeckState = if (activeDeckId == \"A\") dualDeckState.deckA else dualDeckState.deckB"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            val activeAccent = if (activeDeckId == \"A\") DeckACyan else DeckBAmber"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            SingleDeckView("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                deckState = activeDeckState,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                deckId = activeDeckId,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                accentColor = activeAccent,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                otherDeckHasTrack = (if (activeDeckId == \"A\") dualDeckState.deckB else dualDeckState.deckA).track != null,"
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "                onSwitchDeck = { newDeckId -> viewModel.selectSingleDeck(newDeckId) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                onPlayPause = { viewModel.togglePlayPause(activeDeckId) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                onSeek = { pos -> viewModel.seekTo(activeDeckId, pos) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                onSpeedChanged = { speed -> viewModel.setDeckSpeed(activeDeckId, speed) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                onLoop = { viewModel.toggleLoop(activeDeckId) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                onCue = { viewModel.setCue(activeDeckId) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                onJumpCue = { viewModel.jumpToCue(activeDeckId) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                onVolumeChanged = { vol -> viewModel.setDeckVolume(activeDeckId, vol) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                onMasterVolumeChanged = { vol -> viewModel.setMasterVolume(vol) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                masterVolume = dualDeckState.masterVolume,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                onOpenLibrary = { viewModel.selectTab(MainTab.PLAYLISTS) }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        } else {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            // DUAL DECKS (PRO DJ CONSOLE)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            Row("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                modifier = Modifier.fillMaxWidth(),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                horizontalArrangement = Arrangement.spacedBy(10.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            ) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                // DECK A"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                DeckCard("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    deckState = dualDeckState.deckA,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    deckId = \"A\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    accentColor = DeckACyan,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onPlayPause = { viewModel.togglePlayPause(\"A\") },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onSeek = { pos -> viewModel.seekTo(\"A\", pos) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onSpeedChanged = { speed -> viewModel.setDeckSpeed(\"A\", speed) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onLoop = { viewModel.toggleLoop(\"A\") },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onCue = { viewModel.setCue(\"A\") },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onJumpCue = { viewModel.jumpToCue(\"A\") },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onSync = { viewModel.syncBpm(\"A\") },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
