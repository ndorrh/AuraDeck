        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        // Mini Live Visualizer Header Window"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        Box("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
