        lines {
          text: "                    deckState = dualDeckState.deckB,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    deckId = \"B\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
