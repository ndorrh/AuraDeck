        lines {
          text: "                    imageVector = Icons.Default.Fullscreen,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    contentDescription = \"Expand Visualizer\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    tint = Color.White.copy(alpha = 0.7f),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    modifier = Modifier.size(16.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
