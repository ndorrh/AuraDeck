        lines {
          text: "@Composable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "fun EqBandSlider("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    label: String,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    levelMilliBels: Int, // -1200 to +1200"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    onLevelChanged: (Int) -> Unit,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    modifier: Modifier = Modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ") {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val dbValue = (levelMilliBels / 100f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    val fraction = ((levelMilliBels + 1200f) / 2400f).coerceIn(0f, 1f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    Column("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        modifier = modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .width(36.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            .fillMaxHeight(),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        horizontalAlignment = Alignment.CenterHorizontally"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Text("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text = String.format(\"%+.1f\", dbValue),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            color = if (dbValue > 0) DeckBAmber else if (dbValue < 0) DeckACyan else Color.White,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            fontSize = 9.sp,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            fontFamily = FontFamily.Monospace,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            fontWeight = FontWeight.Bold"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Spacer(modifier = Modifier.height(4.dp))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Custom Vertical Touch Slider"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Box("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            modifier = Modifier"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                .weight(1f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                .width(24.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                .clip(RoundedCornerShape(6.dp))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                .background(Color(0xFF0D121D))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                .pointerInput(Unit) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    detectDragGestures { change, _ ->"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        val y = change.position.y"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        val totalH = size.height"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        if (totalH > 0) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            val newFraction = (1f - (y / totalH)).coerceIn(0f, 1f)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            val newMb = ((newFraction * 2400f) - 1200f).toInt()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                            onLevelChanged(newMb)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            contentAlignment = Alignment.BottomCenter"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        ) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            Canvas(modifier = Modifier.fillMaxSize()) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                val w = size.width"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                val h = size.height"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                val midY = h / 2f"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                // Center 0dB Line"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                drawLine("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    color = Color(0xFF334155),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    start = Offset(2f, midY),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    end = Offset(w - 2f, midY),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    strokeWidth = 1.5f"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                // Track Slot"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                drawLine("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    color = Color(0xFF1E293B),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    start = Offset(w / 2f, 4f),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    end = Offset(w / 2f, h - 4f),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    strokeWidth = 4f,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    cap = StrokeCap.Round"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                // Slider Thumb Knob"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                val thumbY = (1f - fraction) * (h - 16f) + 8f"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                drawCircle("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    color = if (dbValue > 0) DeckBAmber else DeckACyan,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    radius = 8f,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    center = Offset(w / 2f, thumbY)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                drawCircle("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    color = Color.White,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    radius = 3f,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    center = Offset(w / 2f, thumbY)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                )"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Spacer(modifier = Modifier.height(4.dp))"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        Text("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            text = label,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            color = Color(0xFF94A3B8),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            fontSize = 9.sp,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            fontFamily = FontFamily.Monospace,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
