        }
        lines {
          text: "                        AudiophileRotaryDial("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            label = \"MASTER VOL\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            valueFraction = dualDeckState.masterVolume,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            onValueChanged = { viewModel.setMasterVolume(it) },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            activeColor = DspSurroundViolet"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
