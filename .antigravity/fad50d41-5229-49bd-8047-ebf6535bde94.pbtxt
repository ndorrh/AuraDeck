  file_change {
    absolute_path_uri: "file:///app/src/main/java/com/example/visualizer/VisualizerEngine.kt"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "package com.example.visualizer\n\nimport android.media.audiofx.Visualizer\nimport android.util.Log\nimport kotlinx.coroutines.*\nimport kotlinx.coroutines.flow.MutableStateFlow\nimport kotlinx.coroutines.flow.StateFlow\nimport kotlinx.coroutines.flow.asStateFlow\nimport kotlin.math.*\nimport kotlin.random.Random\n\nenum class VisualizerMode(val displayName: String, val description: String) {\n    NEON_SPECTRUM(\"Neon Spectrum\", \"1024-pt FFT bars with glowing peak gravity\"),\n    CIRCULAR_WAVE(\"Radial Pulse\", \"360-degree bass reactive circular oscilloscope\"),\n    LISSAJOUS_PHASE(\"Stereo Goniometer\", \"Lissajous stereo phase correlation vector\"),\n    LIQUID_PARTICLES(\"Liquid Particles\", \"Dynamic transient particle field\")\n}\n\ndata class VisualizerFrame(\n    val fftMagnitudes: FloatArray = FloatArray(64) { 0.05f },\n    val peakMagnitudes: FloatArray = FloatArray(64) { 0.05f },\n    val waveformPoints: FloatArray = FloatArray(128) { 0f },\n    val bassEnergy: Float = 0.2f,\n    val midEnergy: Float = 0.2f,\n    val highEnergy: Float = 0.2f,\n    val timestamp: Long = System.currentTimeMillis()\n)\n\nclass VisualizerEngine {\n\n    private var visualizer: Visualizer? = null\n    private var activeSessionId: Int = 0\n\n    private val _currentMode = MutableStateFlow(VisualizerMode.NEON_SPECTRUM)\n    val currentMode: StateFlow<VisualizerMode> = _currentMode.asStateFlow()\n\n    private val _frame = MutableStateFlow(VisualizerFrame())\n    val frame: StateFlow<VisualizerFrame> = _frame.asStateFlow()\n\n    private val coroutineScope = CoroutineScope(Dispatchers.Default + SupervisorJob())\n    private var animationJob: Job? = null\n\n    // Fallback animation phase for smooth continuous visuals\n    private var phase: Float = 0f\n    private val peaks = FloatArray(64) { 0.05f }\n\n    init {\n        startRenderLoop()\n    }\n\n    fun setMode(mode: VisualizerMode) {\n        _currentMode.value = mode\n    }\n\n    fun linkAudioSession(audioSessionId: Int) {\n        if (audioSessionId == 0 || audioSessionId == activeSessionId) return\n        releaseVisualizer()\n        this.activeSessionId = audioSessionId\n\n        try {\n            visualizer = Visualizer(audioSessionId).apply {\n                captureSize = Visualizer.getCaptureSizeRange()[1] // Max 1024\n                setDataCaptureListener(\n                    object : Visualizer.OnDataCaptureListener {\n                        override fun onWaveFormDataCapture(v: Visualizer?, waveform: ByteArray?, rate: Int) {\n                            waveform?.let { processWaveform(it) }\n                        }\n\n                        override fun onFftDataCapture(v: Visualizer?, fft: ByteArray?, rate: Int) {\n                            fft?.let { processFft(it) }\n                        }\n                    },\n                    Visualizer.getMaxCaptureRate() / 2,\n                    true,\n                    true\n                )\n                enabled = true\n            }\n            Log.d(\"VisualizerEngine\", \"Hardware visualizer linked to session $audioSessionId\")\n        } catch (e: Exception) {\n            Log.w(\"VisualizerEngine\", \"Cannot attach hardware visualizer: ${e.message}. Using synthetic reactive engine.\")\n        }\n    }\n\n    private fun processWaveform(bytes: ByteArray) {\n        val points = FloatArray(128)\n        val step = maxOf(1, bytes.size / 128)\n        for (i in 0 until 128) {\n            val byteIndex = (i * step).coerceAtMost(bytes.size - 1)\n            // convert unsigned byte 0..255 to -1.0 .. 1.0\n            points[i] = ((bytes[byteIndex].toInt() and 0xFF) - 128) / 128f\n        }\n        val current = _frame.value\n        _frame.value = current.copy(waveformPoints = points)\n    }\n\n    private fun processFft(bytes: ByteArray) {\n        val bands = 64\n        val magnitudes = FloatArray(bands)\n        val step = maxOf(2, (bytes.size / 2) / bands)\n\n        var bassSum = 0f\n        var midSum = 0f\n        var highSum = 0f\n\n        for (i in 0 until bands) {\n            val idx = i * step * 2\n            if (idx + 1 < bytes.size) {\n                val r = bytes[idx].toFloat()\n                val im = bytes[idx + 1].toFloat()\n                val mag = sqrt(r * r + im * im) / 128f\n                magnitudes[i] = mag.coerceIn(0.02f, 1.0f)\n\n                if (i < 10) bassSum += mag\n                else if (i < 35) midSum += mag\n                else highSum += mag\n\n                // Peak gravity falloff\n                if (magnitudes[i] > peaks[i]) {\n                    peaks[i] = magnitudes[i]\n                } else {\n                    peaks[i] = (peaks[i] - 0.015f).coerceAtLeast(magnitudes[i])\n                }\n            }\n        }\n\n        val bEnergy = (bassSum / 10f).coerceIn(0.1f, 1.0f)\n        val mEnergy = (midSum / 25f).coerceIn(0.1f, 1.0f)\n        val hEnergy = (highSum / 29f).coerceIn(0.1f, 1.0f)\n\n        _frame.value = _frame.value.copy(\n            fftMagnitudes = magnitudes,\n            peakMagnitudes = peaks.clone(),\n            bassEnergy = bEnergy,\n            midEnergy = mEnergy,\n            highEnergy = hEnergy,\n            timestamp = System.currentTimeMillis()\n        )\n    }\n\n    private fun startRenderLoop() {\n        animationJob?.cancel()\n        animationJob = coroutineScope.launch {\n            while (isActive) {\n                delay(16) // ~60 FPS\n                phase += 0.08f\n                if (phase > 2 * PI.toFloat()) phase = 0f\n\n                // If visualizer is null or silent, simulate rich responsive organic soundwaves\n                if (visualizer == null || !visualizer!!.enabled) {\n                    generateSyntheticFrame(phase)\n                }\n            }\n        }\n    }\n\n    private fun generateSyntheticFrame(p: Float) {\n        val bands = 64\n        val mags = FloatArray(bands)\n        val waves = FloatArray(128)\n\n        for (i in 0 until bands) {\n            val freq = (i + 1) * 0.15f\n            val base = (sin(p * 1.5f + freq) * 0.4f + cos(p * 0.8f - freq * 0.5f) * 0.3f + 0.35f).toFloat()\n            val noise = (Random.nextFloat() * 0.12f)\n            val v = (base + noise).coerceIn(0.08f, 0.95f)\n            mags[i] = v\n\n            if (v > peaks[i]) {\n                peaks[i] = v\n            } else {\n                peaks[i] = (peaks[i] - 0.02f).coerceAtLeast(v)\n            }\n        }\n\n        for (i in 0 until 128) {\n            val wavePhase = (i.toFloat() / 128f) * 4 * PI.toFloat() + p * 2f\n            waves[i] = (sin(wavePhase) * 0.5f + sin(wavePhase * 2.3f) * 0.25f).toFloat()\n        }\n\n        val bEnergy = (mags[0] + mags[1] + mags[2] + mags[3]) / 4f\n        val mEnergy = (mags[15] + mags[16] + mags[17]) / 3f\n        val hEnergy = (mags[40] + mags[41] + mags[42]) / 3f\n\n        _frame.value = VisualizerFrame(\n            fftMagnitudes = mags,\n            peakMagnitudes = peaks.clone(),\n            waveformPoints = waves,\n            bassEnergy = bEnergy,\n            midEnergy = mEnergy,\n            highEnergy = hEnergy,\n            timestamp = System.currentTimeMillis()\n        )\n    }\n\n    fun releaseVisualizer() {\n        try {\n            visualizer?.enabled = false\n            visualizer?.release()\n        } catch (_: Exception) {}\n        visualizer = null\n        activeSessionId = 0\n    }\n\n    fun release() {\n        animationJob?.cancel()\n        coroutineScope.cancel()\n        releaseVisualizer()\n    }\n}\n"
    }
