          text: "                            .size(6.dp)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            .clip(CircleShape)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
