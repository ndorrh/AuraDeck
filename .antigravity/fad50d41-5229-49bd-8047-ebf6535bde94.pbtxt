    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQETayZqbI0fxyD8nOe7RIqKPkKLjIXKupOnphrHqR2yoN7lWuX2oWN442-Bhx9NOh354Zi7n_vleqI9MhlCLddMwRoaWzRTwZWoCD5BmB9LIuvSi8K26iWKG0NtVWrw3MFHeTK59WHFXHyFjqb29HpuioSxRIAxNfUHScRSvkDJyfZ38nnA7ButvKhV0z4p"
