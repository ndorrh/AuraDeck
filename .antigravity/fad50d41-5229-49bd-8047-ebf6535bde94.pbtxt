          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    for (i in 0 until bars) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        val magIndex = (i * step).coerceAtMost(frame.fftMagnitudes.size - 1)"
