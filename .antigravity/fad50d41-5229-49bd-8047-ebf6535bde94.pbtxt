          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "@Composable"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "fun AudiophileRotaryDial("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    label: String,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
