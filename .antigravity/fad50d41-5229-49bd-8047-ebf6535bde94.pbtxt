        lines {
          text: "        // Console Layout based on Selected Mode"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (dualDeckState.deckMode == DeckMode.SINGLE_DECK) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            // SINGLE DECK (SOLO AUDIOPHILE PLAYER)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val activeDeckId = dualDeckState.selectedSingleDeck"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val activeDeckState = if (activeDeckId == \"A\") dualDeckState.deckA else dualDeckState.deckB"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            val activeAccent = if (activeDeckId == \"A\") DeckACyan else DeckBAmber"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            SingleDeckView("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                deckState = activeDeckState,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                deckId = activeDeckId,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                accentColor = activeAccent,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                otherDeckHasTrack = (if (activeDeckId == \"A\") dualDeckState.deckB else dualDeckState.deckA).track != null,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                onSwitchDeck = { newDeckId -> viewModel.selectSingleDeck(newDeckId) },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                onPlayPause = { viewModel.togglePlayPause(activeDeckId) },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                onSeek = { pos -> viewModel.seekTo(activeDeckId, pos) },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                onSpeedChanged = { speed -> viewModel.setDeckSpeed(activeDeckId, speed) },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                onLoop = { viewModel.toggleLoop(activeDeckId) },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
