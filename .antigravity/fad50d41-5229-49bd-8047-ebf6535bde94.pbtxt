        lines {
          text: "                    onLoop = { viewModel.toggleLoop(\"B\") },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onCue = { viewModel.setCue(\"B\") },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onJumpCue = { viewModel.jumpToCue(\"B\") },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    onSync = { viewModel.syncBpm(\"B\") },"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
