          text: "                    )"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    Spacer(modifier = Modifier.width(6.dp))"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    Text("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        text = \"DSP LIVE: ${visualizerMode.displayName.uppercase()}\","
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        color = Color.White.copy(alpha = 0.85f),"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        fontSize = 10.sp,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        fontFamily = FontFamily.Monospace,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        fontWeight = FontWeight.Bold"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
